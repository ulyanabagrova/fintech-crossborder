{
  "version": 2,
  "builds": [
    {
      "src": "apps/backend/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "apps/backend/api/index.ts?path=$1"
    },
    {
      "src": "/(.*)",
      "dest": "apps/backend/api/index.ts"
    }
  ]
}