page {
  background-color: #0F1214;
  color: #F3EFE6;
  font-family: 'Inter', sans-serif;
}

.container {
  padding: 40rpx 30rpx;
  padding-bottom: 200rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: radial-gradient(circle at 50% 0%, #1E232B 0%, #14171C 55%);
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #F3EFE6;
  letter-spacing: -0.01em;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #ABA492;
  font-size: 28rpx;
}

.cards-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Карточки в стиле .ticket из дизайн-системы */
.card-item {
  position: relative;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  color: #1B2430;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1), 0 14px 28px -14px rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(212, 175, 106, 0.14);
}

/* Акцент для сета (красная полоса слева в тон бренду) */
.card-item.set-item {
  border-left: 8rpx solid #C1272D;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-divider {
  height: 2rpx;
  background-color: rgba(212, 175, 106, 0.16);
  margin-bottom: 24rpx;
  border-top: 2rpx dashed rgba(212, 175, 106, 0.16);
}

.title-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.type-badge {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  background: #F3EFE6;
  color: #1B2430;
}

.type-badge.set {
  background: rgba(193, 39, 45, 0.1);
  color: #C1272D;
}

.store-name {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #1B2430;
}

.status-tag {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(31, 92, 79, 0.12);
  color: #1F5C4F;
  font-weight: 600;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 28rpx;
  color: #7A7265;
}

.value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1B2430;
}

.value.balance {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 32rpx;
  color: #1F5C4F;
}

.value.price {
  font-family: 'IBM Plex Mono', monospace;
  color: #1B2430;
}

.value.code {
  font-family: 'IBM Plex Mono', monospace;
  color: #C1272D;
  letter-spacing: 2rpx;
}

/* Фиксированная нижняя панель с кнопкой */
.bottom-qr-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(20, 23, 27, 0.85);
  backdrop-filter: blur(16px);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1px solid rgba(212, 175, 106, 0.14);
  z-index: 100;
}

.qr-pay-btn {
  background: #C1272D;
  color: #F3EFE6;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 14rpx;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 10px 20px -8px rgba(193, 39, 45, 0.5);
}