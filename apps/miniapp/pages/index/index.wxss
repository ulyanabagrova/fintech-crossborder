/* ==== GiftPay design tokens (kept local — WXSS has no :root/var() support) ==== */
/* --red:#C1272D  --jade:#1F5C4F  --gold:#D4AF6A  --ink:#1B2430
   --paper:#F3EFE6  --card-tint:#FBEAE7  --bg:#14171C            */

.container {
  padding: 16px;
  background-color: #14171C;
  background-image: radial-gradient(circle at 50% 0%, #1E232B 0%, #14171C 55%);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---------- section headers ---------- */
.section-row {
  margin-top: 20px;
  margin-bottom: 14px;
}
.section-eyebrow {
  display: block;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #D4AF6A;
  margin-bottom: 4px;
}
.section-title {
  font-size: 18px;
  font-weight: 700;
  color: #F3EFE6;
}

/* ---------- ticket / voucher card ---------- */
.card-item {
  position: relative;
  background: #FFFFFF;
  border-radius: 20px;
  border: 1px solid rgba(212, 175, 106, 0.16);
  padding: 16px;
  margin-bottom: 14px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: 0 16px 30px -16px rgba(0, 0, 0, 0.6);
  overflow: hidden;
}
.card-item-set {
  border-color: rgba(31, 92, 79, 0.25);
}

/* punch-hole notches — the voucher/ticket signature */
.notch {
  position: absolute;
  top: 50%;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #14171C;
  margin-top: -8px;
  z-index: 2;
}
.notch-left { left: -8px; }
.notch-right { right: -8px; }

/* dashed tear-line between header and footer */
.card-dash {
  border-top: 2px dashed rgba(27, 36, 48, 0.12);
  margin: 0 -4px;
}

/* Верхняя строка: Название слева, Баланс справа */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}
.card-title {
  font-size: 16px;
  font-weight: 700;
  color: #1B2430;
  flex: 1;
}
.card-balance-pill {
  background: #EAF0EC;
  border-radius: 8px;
  padding: 4px 10px;
  white-space: nowrap;
}
.card-balance {
  font-size: 12px;
  color: #1F5C4F;
  font-weight: 700;
}

/* Нижняя строка: Кнопки слева, Цена справа */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}
.card-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

/* ---------- buttons ---------- */
.btn-action {
  font-size: 12px;
  padding: 8px 14px;
  border-radius: 10px;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  box-sizing: border-box;
}
.btn-add {
  background: transparent;
  color: #1B2430;
  border: 1.5px solid rgba(27, 36, 48, 0.14);
}
.btn-buy {
  background: #C1272D;
  color: #F3EFE6;
  box-shadow: 0 8px 16px -8px rgba(193, 39, 45, 0.5);
}
.btn-hover {
  opacity: 0.75;
}

/* Правый блок цены */
.card-price-container {
  text-align: right;
  white-space: nowrap;
  margin-left: auto;
}
.card-price-label {
  font-size: 9px;
  color: #A69F8D;
  display: block;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.card-price {
  font-size: 17px;
  font-weight: 700;
  color: #1B2430;
}

.bottom-spacer {
  height: 84px;
}

/* ---------- bottom nav ---------- */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 14px 16px;
  background: rgba(20, 23, 27, 0.85);
  border-top: 1px solid rgba(212, 175, 106, 0.16);
  gap: 12px;
  z-index: 100;
  box-sizing: border-box;
}
.nav-btn {
  flex: 1;
  font-size: 13px;
  font-weight: 700;
  border-radius: 20px;
  padding: 12px 0;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.nav-ic {
  font-size: 14px;
}
.nav-btn-cards {
  background: transparent;
  color: #F3EFE6;
  border: 1.5px solid rgba(243, 239, 230, 0.2);
}
.nav-btn-cart {
  background: #C1272D;
  color: #F3EFE6;
  box-shadow: 0 8px 18px -8px rgba(193, 39, 45, 0.6);
}
