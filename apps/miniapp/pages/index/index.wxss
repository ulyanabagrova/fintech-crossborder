/* Отступ снизу для всей страницы, чтобы контент не перекрывался кнопкой корзины */
.page-container {
  padding-bottom: 100rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin: 30rpx 20rpx 15rpx 20rpx;
  color: #111;
}

.card-list {
  padding: 0 20rpx;
}

.card-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.card-price {
  font-size: 28rpx;
  color: #007aff;
  font-weight: bold;
  margin-top: 6rpx;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 12rpx 0;
  line-height: 1.4;
}

.btn-secondary {
  background-color: #f2f3f5;
  color: #1d2129;
}

.btn-primary {
  background-color: #007aff;
  color: #ffffff;
}

/* ФИКСИРОВАННАЯ ПАНЕЛЬ КОРЗИНЫ ВНИЗУ */
.fixed-cart-bar {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  height: 100rpx;
  background-color: #1c1c1e;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.25);
  z-index: 999;
}

.cart-bar-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cart-icon-wrapper {
  position: relative;
  font-size: 40rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  background-color: #ff3b30;
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.cart-bar-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.cart-arrow {
  color: #8e8e93;
  font-size: 44rpx;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 12rpx;
  padding: 20rpx 30rpx;
  background: #ffffff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-my-cards, .btn-cart {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-my-cards {
  background-color: #f0f2f5;
  color: #1a1a1a;
}

.btn-cart {
  background-color: #07c160;
  color: #ffffff;
}