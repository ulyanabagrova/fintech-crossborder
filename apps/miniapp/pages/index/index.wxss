.container {
  padding: 16px;
  background-color: #010101;
  min-height: 100vh;
  box-sizing: border-box;
}

.section-title {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12px;
  margin-top: 16px;
}

.card-item {
  background: #1e1e1e;
  border: 1px solid #2a2a2a;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 12px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* Верхняя строка: Название слева, Баланс справа */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.card-title {
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
  flex: 1;
}

.card-balance {
  font-size: 13px;
  color: #07c160;
  font-weight: 600;
  white-space: nowrap;
}

/* Нижняя строка: Кнопки слева, Цена справа */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.card-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

/* Безопасные кнопки на базе view */
.btn-action {
  font-size: 12px;
  padding: 7px 12px;
  border-radius: 6px;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
  box-sizing: border-box;
}

.btn-add {
  background: #2a2a2a;
  color: #ffffff;
  border: 1px solid #444444;
}

.btn-buy {
  background: #07c160;
  color: #ffffff;
}

.btn-hover {
  opacity: 0.8;
}

/* Правый блок цены */
.card-price-container {
  text-align: right;
  white-space: nowrap;
  margin-left: auto; /* Жестко прижимает блок к правому краю */
}

.card-price-label {
  font-size: 10px;
  color: #888888;
  display: block;
  text-transform: uppercase;
}

.card-price {
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
}

.bottom-spacer {
  height: 80px;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 12px 16px;
  background: #1a1a1a;
  border-top: 1px solid #333;
  gap: 12px;
  z-index: 100;
  box-sizing: border-box;
}

.nav-btn {
  flex: 1;
  font-size: 14px;
  font-weight: bold;
  border-radius: 20px;
  padding: 10px 0;
  text-align: center;
}

.nav-btn-cards {
  background: #2a2a2a;
  color: #fff;
}

.nav-btn-cart {
  background: #07c160;
  color: #fff;
}