<view class="page-container">

  <!-- СЕКЦИЯ СЕТОВ -->
  <view class="section-title">Сеты ваучеров</view>
  <view class="card-list">
    <block wx:for="{{voucherSets}}" wx:key="id">
      <view class="card-item">
        <view class="card-info">
          <text class="card-title">{{item.title || 'Сет ваучеров'}}</text>
          <text class="card-price">{{item.total_price_rub}} ₽</text>
        </view>

        <!-- Кнопки действия -->
        <view class="card-actions">
          <button class="btn btn-secondary" bindtap="onAddToCart" data-type="set" data-id="{{item.id}}">
            🛒 В корзину
          </button>
          <button class="btn btn-primary" bindtap="onBuyNow" data-type="set" data-id="{{item.id}}">
            ⚡ Купить
          </button>
        </view>
      </view>
    </block>
  </view>

  <!-- СЕКЦИЯ ОТДЕЛЬНЫХ КАРТ -->
  <view class="section-title">Отдельные карты</view>
  <view class="card-list">
    <block wx:for="{{voucherCards}}" wx:key="id">
      <view class="card-item">
        <view class="card-info">
          <text class="card-title">{{item.store_name}}</text>
          <text class="card-price">Баланс: {{item.balance_rub}} ₽</text>
        </view>

        <!-- Кнопки действия -->
        <view class="card-actions">
          <button class="btn btn-secondary" bindtap="onAddToCart" data-type="card" data-id="{{item.id}}">
            🛒 В корзину
          </button>
          <button class="btn btn-primary" bindtap="onBuyNow" data-type="card" data-id="{{item.id}}">
            ⚡ Купить
          </button>
        </view>
      </view>
    </block>
  </view>

  <!-- НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ "МОИ КАРТЫ" И "КОРЗИНА" -->
  <view class="bottom-bar">
    <button class="btn-my-cards" bindtap="goToMyCards">
      <text>🎴 Мои карты</text>
    </button>

    <button class="btn-cart" bindtap="goToCart">
      <text>🛒 Корзина</text>
      <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
    </button>
  </view>

</view>