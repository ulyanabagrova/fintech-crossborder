<view class="container">
  <!-- Секция карт -->
  <view class="section">
    <view class="section-title">Ваучерные карты</view>
    <view class="cards-list">
      <block wx:for="{{voucherCards}}" wx:key="id">
        <view class="card-item">
          
          <!-- Верхняя линия: Название и Баланс -->
          <view class="card-header">
            <text class="card-title">{{item.title}}</text>
            <text class="card-balance">Баланс: {{item.balanceFormatted}} ₽</text>
          </view>

          <!-- Нижняя линия: Кнопки слева, Цена справа -->
          <view class="card-footer">
            <view class="card-actions">
              <view 
                class="btn-action btn-add" 
                hover-class="btn-hover"
                bindtap="onAddToCart" 
                data-id="{{item.id}}" 
                data-type="card">
                В корзину
              </view>
              <view 
                class="btn-action btn-buy" 
                hover-class="btn-hover"
                bindtap="onBuyNow" 
                data-id="{{item.id}}" 
                data-type="card">
                Купить
              </view>
            </view>
            
            <view class="card-price-container">
              <text class="card-price-label">Цена:</text>
              <text class="card-price">{{item.priceFormatted}} ₽</text>
            </view>
          </view>

        </view>
      </block>
    </view>
  </view>

  <!-- Секция сетов -->
  <view class="section">
    <view class="section-title">Сеты ваучеров</view>
    <view class="sets-list">
      <block wx:for="{{voucherSets}}" wx:key="id">
        <view class="card-item">
          
          <!-- Верхняя линия: Название и Баланс -->
          <view class="card-header">
            <text class="card-title">{{item.title}}</text>
            <text class="card-balance">Баланс: {{item.balanceFormatted}} ₽</text>
          </view>

          <!-- Нижняя линия: Кнопки слева, Цена справа -->
          <view class="card-footer">
            <view class="card-actions">
              <view 
                class="btn-action btn-add" 
                hover-class="btn-hover"
                bindtap="onAddToCart" 
                data-id="{{item.id}}" 
                data-type="set">
                В корзину
              </view>
              <view 
                class="btn-action btn-buy" 
                hover-class="btn-hover"
                bindtap="onBuyNow" 
                data-id="{{item.id}}" 
                data-type="set">
                Купить
              </view>
            </view>
            
            <view class="card-price-container">
              <text class="card-price-label">Цена:</text>
              <text class="card-price">{{item.priceFormatted}} ₽</text>
            </view>
          </view>

        </view>
      </block>
    </view>
  </view>

  <view class="bottom-spacer"></view>

  <!-- Фиксированное меню внизу -->
  <view class="bottom-nav">
    <view class="nav-btn nav-btn-cards" hover-class="btn-hover" bindtap="goToMyCards">🎟️ Мои ваучеры</view>
    <view class="nav-btn nav-btn-cart" hover-class="btn-hover" bindtap="goToCart">🛒 Корзина</view>
  </view>
</view>