<view class="container" wx:if="{{receipt}}">
  <view class="success-icon">✅</view>
  <text class="status-title">Оплата успешно проведена</text>
  <text class="store-name">{{receipt.store}}</text>

  <view class="card-box">
    <view class="card-badge">
      <text>{{receipt.paidFrom === 'voucher_set' ? '🎫 Ваучерный сет' : '💳 Карта магазина'}}</text>
    </view>
    <text class="card-title">{{receipt.title}}</text>

    <view class="divider"></view>

    <view class="row">
      <text class="label">Было на балансе:</text>
      <text class="value">{{receipt.balanceBefore}} ₽</text>
    </view>

    <view class="row highlight">
      <text class="label">Вычтено:</text>
      <text class="value price">-{{receipt.deducted}} ₽</text>
    </view>

    <view class="divider"></view>

    <view class="row total">
      <text class="label">Остаток на балансе:</text>
      <text class="value bold">{{receipt.remainingBalance}} ₽</text>
    </view>
  </view>

  <button class="btn-home" bindtap="goHome">На главную</button>
</view>