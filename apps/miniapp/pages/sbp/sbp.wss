.container {
  padding: 30rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.scan-card, .payment-card, .status-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
}

.icon {
  font-size: 90rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
}

.subtitle {
  font-size: 26rpx;
  color: #8c8c8c;
  margin-top: 10rpx;
  margin-bottom: 40rpx;
  display: block;
}

.btn-primary {
  background: #07c160;
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.btn-secondary {
  background: #f2f3f5;
  color: #323233;
  border-radius: 48rpx;
  font-size: 30rpx;
}

.btn-link {
  background: transparent;
  color: #8c8c8c;
  font-size: 28rpx;
  margin-top: 10rpx;
}

.badge {
  display: inline-block;
  background: #e8f4ff;
  color: #1989fa;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  margin-bottom: 30rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.label { color: #8c8c8c; font-size: 28rpx; }
.value { font-size: 28rpx; color: #1a1a1a; }
.bold { font-weight: 600; }
.price { font-size: 38rpx; font-weight: 700; color: #ee0a24; }

.actions { margin-top: 40rpx; }

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #1989fa;
  border-radius: 50%;
  margin: 30rpx auto;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* Красный блок ошибок */
.error-box {
  margin-top: 30rpx;
  background: #fff0f0;
  border: 1rpx solid #ffccc7;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: left;
}

.error-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.error-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #d9363e;
}

.copy-btn {
  font-size: 20rpx !important;
  padding: 4rpx 16rpx !important;
  margin: 0 !important;
  width: auto !important;
  background: #ff4d4f;
  color: white;
  border-radius: 20rpx;
}

.error-message {
  font-size: 24rpx;
  color: #cf1322;
  font-weight: 600;
  display: block;
}

.error-details {
  font-size: 20rpx;
  color: #8c8c8c;
  font-family: monospace;
  margin-top: 10rpx;
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
}

.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-card {
  width: 80%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
}

.modal-title { font-size: 32rpx; font-weight: bold; display: block; }
.modal-body { font-size: 28rpx; color: #666; margin: 20rpx 0 40rpx; display: block; }

.modal-actions { display: flex; gap: 20rpx; }
.btn-cancel { flex: 1; background: #f5f5f5; color: #333; font-size: 28rpx; border-radius: 40rpx; }
.btn-confirm { flex: 1; background: #1989fa; color: #fff; font-size: 28rpx; border-radius: 40rpx; }