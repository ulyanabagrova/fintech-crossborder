<view class="container">
  <view class="header">
    <text class="title">🛒 Корзина</text>
  </view>

  <!-- Состояние "Пусто" -->
  <view wx:if="{{!cartItems || cartItems.length === 0}}" class="empty-state">
    <text>Корзина пуста</text>
  </view>

  <!-- Список товаров -->
  <view class="cards-list" wx:if="{{cartItems && cartItems.length > 0}}">
    <block wx:for="{{cartItems}}" wx:key="id">
      <view class="ticket card-item {{item.itemType === 'set' ? 'set-item' : ''}}">
        <view class="card-header">
          <view class="title-group">
            <text class="type-badge {{item.itemType === 'set' ? 'set' : ''}}">
              {{item.itemType === 'card' ? 'Карта' : 'Сет'}} {{item.quantity > 1 ? 'x' + item.quantity : ''}}
            </text>
            <text class="store-name">{{item.title || item.name || 'Товар'}}</text>
          </view>
        </view>
        
        <view class="card-divider"></view>

        <view class="card-body">
          <view class="info-row">
            <text class="label">Баланс</text>
            <text class="value balance">{{item.balanceRub || item.balance_rub || item.nominal || 0}} ₽</text>
          </view>
          
          <view class="info-row">
            <text class="label">Цена</text>
            <text class="value price">{{item.priceRub || item.price_rub || item.cost_price_rub || 0}} ₽</text>
          </view>
        </view>

        <view class="card-footer-action">
          <view bindtap="removeItem" data-id="{{item.id}}" class="delete-btn">
            Удалить
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- Фиксированная нижняя панель: Итого и Кнопка Оплаты -->
  <view class="bottom-checkout-bar" wx:if="{{cartItems && cartItems.length > 0}}">
    <view class="summary-row">
      <text class="summary-label">Итого к оплате:</text>
      <text class="summary-value">{{totalPrice || 0}} ₽</text>
    </view>
    
    <button class="checkout-btn" bindtap="checkout">
      Оплатить
    </button>
  </view>
</view>